# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pathfinder

# Used to sign JWT auth tokens - set this to any long random string
SECRET_KEY=change-this-to-a-long-random-string

# Groq API key for the AI tutor chat. Get a free key at https://console.groq.com/keys
# Leave blank to run the tutor in mock mode (no real replies).
GROQ_API_KEY=

# Optional - defaults to llama-3.3-70b-versatile
TUTOR_MODEL=llama-3.3-70b-versatile
